# Host build output and dependencies. These are rebuilt inside the image, and copying them in would
# drop the host's own architecture-specific binaries on top of the ones just installed.
node_modules
**/node_modules
dist
**/dist
build
**/build
coverage
**/coverage
*.tsbuildinfo
services/backend/public

# Generated at run time and bind-mounted from the host, because the peer containers mount the same
# directory. A copy baked into the image would only go stale.
fabric/**/organizations/peerOrganizations
fabric/**/organizations/ordererOrganizations
fabric/**/channel-artifacts
fabric/**/system-genesis-block
fabric/**/*.block
fabric/**/*.tar.gz
fabric/**/wallet

.git
.github
.DS_Store
**/.DS_Store
*.log
*.checkpoint
.env
.env.*
!.env.example
