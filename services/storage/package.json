{
  "name": "@fresh-milk/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "demo:tamper": "pnpm build && node dist/tamperEvidence.js",
    "test:integration": "pnpm build && RUN_POSTGRES_INTEGRATION=1 node --test test/postgres.integration.test.mjs"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0"
  }
}
